# ─── Supabase Postgres ─────────────────────────────────────────────
# In Supabase dashboard: Project → Settings → Database → Connection string.
#
# DATABASE_URL = "Transaction" pooler (port 6543). Used at runtime by the app.
#   Must include ?pgbouncer=true&connection_limit=1 for Prisma compatibility.
# DIRECT_URL   = "Session" / direct connection (port 5432). Used by
#   `prisma db push`, `prisma migrate`, and `prisma db seed` only.
#
# Replace [PASSWORD] with your DB password and [PROJECT-REF] with your ref.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Random 32-byte base64 string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-me"

# Local dev: http://localhost:3000
# Production: your full deployed URL, e.g. https://paradox-manage.vercel.app
NEXTAUTH_URL="http://localhost:3000"
